# Copy to .env.local and fill in real values.
# Local development: `pnpm dev:db` starts a throw-away Postgres on 127.0.0.1:5655. Never point this at the live database.

DATABASE_URL="postgresql://postgres:dev-only-password@127.0.0.1:5655/saas_dev"
REDIS_URL="redis://127.0.0.1:6379"
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Signs certificate verification hashes. Changing it invalidates every issued certificate.
CERT_SECRET="generate-with: openssl rand -base64 32"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Notifications (fee reminders). Leave blank until you have an account; messages then wait in the queue. ---
# Which channel reminders use: sms | whatsapp | email (default sms)
FEE_REMINDER_CHANNEL="sms"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
# WhatsApp through AiSensy (preferred): the project's API Campaign Key. Campaign names: lib/notify/whatsapp.ts.
AISENSY_API_KEY=""
# ...or the Meta WhatsApp Cloud API directly (used only when AISENSY_API_KEY is empty)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE=""
# E-mail via any SMTP mailbox (preferred). Gmail: smtp.gmail.com:465 by default, EMAIL_PASS = a Google "app password".
EMAIL_USER=""
EMAIL_PASS=""
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT="465"
# Or SendGrid instead of SMTP:
SENDGRID_API_KEY=""
MAIL_FROM=""
# Multi-tenancy. Each institute works at <slug>.ROOT_DOMAIN (or a verified custom domain); admin.ROOT_DOMAIN is the
# platform console; ROOT_DOMAIN itself is the public site. Development: <slug>.localhost works as is.
ROOT_DOMAIN=""
# Development and the end-to-end run only: the bare host (localhost) is this org's workspace. Never set it in production.
DEFAULT_ORG_SLUG="sample"
# Platform mailer sender name (for institutes that have not set up their own e-mail)
MAIL_FROM_NAME=""

# Links in e-mails, receipts and QR codes use each institute's own address: its verified custom domain, else
# https://<slug>.ROOT_DOMAIN. APP_URL is only for installs without ROOT_DOMAIN (the default org's address, e.g.
# http://localhost:3000). The live server never builds links from the request's host.
APP_URL=""

# Shared secret for the daily jobs (POST /api/jobs/reminders and /api/jobs/reconcile with "Authorization: Bearer <secret>")
CRON_SECRET=""
# Optional: e-mail address that receives an alert when a daily job fails or reconciliation finds a mismatch
# (needs SENDGRID_API_KEY + MAIL_FROM). Without it, alerts still show on the super admin dashboard.
ALERT_EMAIL=""
# Set to false to skip running database migrations when the container starts
RUN_MIGRATIONS="true"

# Sign-in security. How many proxies sit in front of the app: the real visitor IP is the one the proxy appends to
# X-Forwarded-For (1 = Coolify/Traefik only; 2 = Cloudflare in front of Traefik). Used for sign-in locks and IP blocks.
TRUSTED_PROXY_HOPS=1
# Location of sign-in IPs (city / network) for Administration → Sign-in Security, looked up from ipwho.is. "off" to disable.
IP_GEO_LOOKUP=on
